# Copy to ~/.config/yao-app-source/home-source.env and chmod 600.
# Replace these reserved example values locally; never commit your real address.
APP_SOURCE_DOMAIN=source.example
APP_SOURCE_BASE_URL=https://source.example:15006
# Enable only after latest-package migration and public-source verification.
APP_SOURCE_REDIRECT_URL=
HOME_SOURCE_ROOT=/absolute/path/to/SignOs/packages/home-source/public
HOME_SOURCE_CERTIFICATES=/absolute/path/to/private/acme
