server {
    listen 15006 ssl;
    server_name ${APP_SOURCE_DOMAIN};
    ssl_certificate /certificates/certificates/${APP_SOURCE_DOMAIN}.crt;
    ssl_certificate_key /certificates/certificates/${APP_SOURCE_DOMAIN}.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    root /srv/source;
    server_tokens off;
    autoindex off;
    sendfile on;
    max_ranges 1;
    large_client_header_buffers 4 16k;
    set $source_redirect "${APP_SOURCE_REDIRECT_URL}";

    location = /api/upload {
        if ($source_redirect != "") { return 410; }
        client_max_body_size 2g;
        client_body_timeout 300s;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_http_version 1.1;
        proxy_set_header Connection close;
        proxy_read_timeout 900s;
        proxy_send_timeout 300s;
        proxy_pass http://host.docker.internal:15007;
        # Request queries may contain metadata; keep them out of access logs.
        access_log off;
    }

    location = /source.json {
        if ($request_method !~ ^(GET|HEAD)$) { return 405; }
        if ($source_redirect != "") { return 302 $source_redirect; }
        limit_except GET { deny all; }
        default_type application/json;
        add_header Cache-Control "no-store" always;
        try_files /source.json =404;
    }
    location = /appstore {
        if ($request_method !~ ^(GET|HEAD)$) { return 405; }
        if ($source_redirect != "") { return 302 $source_redirect; }
        limit_except GET { deny all; }
        default_type application/json;
        add_header Cache-Control "no-store" always;
        try_files /source.json =404;
    }
    location ~ ^/files/[A-Za-z0-9._-]+\.(ipa|png)$ {
        limit_except GET { deny all; }
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }
    location / { return 404; }
}
